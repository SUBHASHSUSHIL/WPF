<Window x:Class="CRUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CRUD"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <Grid ColumnDefinitions="400,*">
        <StackPanel Grid.Column="0">
            <TextBlock Text="CRUD Operation" FontSize="20" FontWeight="Bold" Margin="10"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Name:" Width="100" Margin="10"/>
                <TextBox x:Name="nameTextBox" Width="200" Margin="10"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Email:" Width="100" Margin="10"/>
                <TextBox x:Name="emailTextBox" Width="200" Margin="10"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Phone:" Width="100" Margin="10"/>
                <TextBox x:Name="phoneTextBox" Width="200" Margin="10"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10">
                <Button Content="Create" Width="95" Click="CreateButton_Click"/>
                <Button Content="Update" Width="95" Margin="10 0 0 0" Click="UpdateButton_Click"/>
                <Button Content="Delete" Width="95" Margin="10 0 0 0" Click="DeleteButton_Click"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBlock Text="Contacts List" FontSize="20" FontWeight="Bold" Margin="10"/>
            <ListView x:Name="contactsListView"
                      SelectionChanged="contactsListView_SelectionChanged"
                      Height="350"
                      Margin="10">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Username}" Width="100"/>
                            <TextBlock Text="{Binding Email}" Width="150"/>
                            <TextBlock Text="{Binding Phone}" Width="100"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Window>
